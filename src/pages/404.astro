---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="fr" title="404 — Page non trouvée" description="Page non trouvée">
  <section class="py-24 text-center">
    <h1 class="text-6xl font-bold">404</h1>
    <p class="mt-4 text-lg">Page non trouvée / Page not found / 页面未找到</p>
    <div class="mt-6 flex gap-4 justify-center">
      <a href="/fr/" class="text-accent underline">← Accueil</a>
      <a href="/en/" class="text-accent underline">← Home</a>
      <a href="/zh/" class="text-accent underline">← 首页</a>
    </div>
  </section>
</BaseLayout>
