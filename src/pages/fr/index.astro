---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SelectedPalettePanel from '../../components/SelectedPalettePanel.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import SidebarTOC from '../../components/SidebarTOC.astro';
import KeyFiguresGrid from '../../components/KeyFiguresGrid.astro';
import ProgramFilter from '../../components/ProgramFilter.astro';
import CourseLinks from '../../components/CourseLinks.astro';
import InnovationContest from '../../components/InnovationContest.astro';
import ClubsList from '../../components/ClubsList.astro';
import InnovationSemesterWall from '../../components/InnovationSemesterWall.astro';
import PartnersCarousel from '../../components/PartnersCarousel.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import { useTranslations } from '../../i18n/utils';
import { getEntry, render } from 'astro:content';

const lang = 'fr' as const;
const t = useTranslations(lang);
const about = await getEntry('sections', `${lang}/01-about`);
const courses = await getEntry('sections', `${lang}/06-courses`);
const partners = await getEntry('sections', `${lang}/04-partners`);
const { Content: About } = await render(about!);
const { Content: Courses } = await render(courses!);
const { Content: Partners } = await render(partners!);
---
<BaseLayout lang={lang} title="UTSEUS - Institut sino-français en ingénierie" description="UTSEUS : institut sino-français en ingénierie à l’Université de Shanghai.">
  <Hero lang={lang} title={t('hero.title')} tagline={t('hero.tagline')} />
  <SelectedPalettePanel lang={lang} />
  <div class="mx-auto max-w-7xl px-4 grid lg:grid-cols-[260px_1fr] gap-8">
    <SidebarTOC lang={lang} />
    <div>
      <SectionBlock id="about" title={t('section.about.title')}>
        <KeyFiguresGrid lang={lang} />
        <About />
      </SectionBlock>
      <SectionBlock id="courses" title={t('section.courses.title')}>
        <ProgramFilter lang={lang} />
        <Courses />
        <CourseLinks lang={lang} />
        <InnovationContest lang={lang} />
      </SectionBlock>
      <SectionBlock id="campuslife" title={t('section.campuslife.title')}>
        <ClubsList lang={lang} />
        <InnovationSemesterWall lang={lang} />
      </SectionBlock>
      <SectionBlock id="partners" title={t('section.partners.title')}>
        <Partners />
        <PartnersCarousel lang={lang} />
      </SectionBlock>
      <SectionBlock id="testimonials" title={t('section.testimonials.title')}>
        <TestimonialCarousel lang={lang} />
      </SectionBlock>
      <SectionBlock id="contact" title={t('section.contact.title')}>
      </SectionBlock>
    </div>
  </div>
</BaseLayout>
