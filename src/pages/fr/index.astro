---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SelectedPalettePanel from '../../components/SelectedPalettePanel.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import SidebarTOC from '../../components/SidebarTOC.astro';
import SectionMedia from '../../components/SectionMedia.astro';
import KeyFiguresGrid from '../../components/KeyFiguresGrid.astro';
import ProgramFilter from '../../components/ProgramFilter.astro';
import ProjectModal from '../../components/ProjectModal.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import { useTranslations } from '../../i18n/utils';
import { getEntry, render } from 'astro:content';

const lang = 'fr' as const;
const t = useTranslations(lang);
const about = await getEntry('sections', `${lang}/01-about`);
const mobility = await getEntry('sections', `${lang}/02-mobility`);
const complexcity = await getEntry('sections', `${lang}/03-complexcity`);
const projects = await getEntry('sections', `${lang}/04-projects`);
const contact = await getEntry('sections', `${lang}/05-contact`);
const { Content: About } = await render(about!);
const { Content: Mobility } = await render(mobility!);
const { Content: Complex } = await render(complexcity!);
const { Content: Projects } = await render(projects!);
const { Content: Contact } = await render(contact!);
---
<BaseLayout lang={lang} title="UTSEUS - Institut sino-français en ingénierie" description="UTSEUS : institut sino-français en ingénierie à l’Université de Shanghai.">
  <Hero lang={lang} title={t('hero.title')} tagline={t('hero.tagline')} />
  <SelectedPalettePanel lang={lang} />
  <div class="mx-auto max-w-7xl px-4 grid lg:grid-cols-[200px_1fr] gap-8">
    <SidebarTOC lang={lang} />
    <div>
      <SectionBlock id="about" title={t('section.about.title')}>
        <SectionMedia src="/images/generated/section-about.png" alt="Étudiants et enseignants travaillant dans un atelier d’ingénierie international" />
        <KeyFiguresGrid lang={lang} />
        <About />
      </SectionBlock>
      <SectionBlock id="mobility" title={t('section.mobility.title')}>
        <SectionMedia src="/images/generated/section-mobility.png" alt="Étudiants internationaux arrivant sur un campus moderne" />
        <Mobility />
        <ProgramFilter lang={lang} />
      </SectionBlock>
      <SectionBlock id="complexcity" title={t('section.complexcity.title')}>
        <SectionMedia src="/images/generated/section-complexcity.png" alt="Laboratoire de recherche sur les données urbaines et la ville intelligente" />
        <Complex />
      </SectionBlock>
      <SectionBlock id="projects" title={t('section.projects.title')}>
        <SectionMedia src="/images/generated/section-projects.png" alt="Maquette de ville intelligente avec capteurs et flux de données" />
        <Projects />
        <ProjectModal lang={lang} />
      </SectionBlock>
      <SectionBlock id="testimonials" title={t('section.testimonials.title')}>
        <TestimonialCarousel lang={lang} />
      </SectionBlock>
      <SectionBlock id="contact" title={t('section.contact.title')}>
        <SectionMedia src="/images/generated/section-contact.png" alt="Bureau universitaire avec documentation et ordinateur" />
        <Contact />
      </SectionBlock>
    </div>
  </div>
</BaseLayout>
