---
interface Props {
  name: string;
  role: string;
  email: string;
}

const { name, role, email } = Astro.props;
---

<article class="contact-card">
  <div class="contact-card__badge" aria-hidden="true">
    <svg viewBox="0 0 32 26" role="img">
      <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h23A2.5 2.5 0 0 1 30 2.5v21a2.5 2.5 0 0 1-2.5 2.5h-23A2.5 2.5 0 0 1 2 23.5v-21Z" />
      <circle cx="11" cy="9" r="4" fill="white" />
      <path d="M5.5 21c.5-4 2.6-6.2 5.5-6.2s5 2.2 5.5 6.2" fill="white" />
      <path d="M18 7h8M18 12h8M18 17h8" stroke="white" stroke-width="2" stroke-linecap="round" />
    </svg>
  </div>
  <div class="contact-card__body">
    <p class="contact-card__role">{role}</p>
    <div class="contact-card__identity">
      <p class="contact-card__name">{name}</p>
      <dl class="contact-card__details">
        <div>
          <dt>
            <span class="sr-only">Email</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.8 5h16.4c.9 0 1.6.7 1.6 1.6v10.8c0 .9-.7 1.6-1.6 1.6H3.8c-.9 0-1.6-.7-1.6-1.6V6.6C2.2 5.7 2.9 5 3.8 5Zm.8 2.8 7.4 5.1 7.4-5.1" />
            </svg>
          </dt>
          <dd><a href={`mailto:${email}`}>{email}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</article>

<style>
  .contact-card {
    display: flex;
    min-height: 180px;
    flex-direction: column;
    gap: 0.9rem;
    border: 1px solid rgba(14, 41, 52, 0.06);
    border-radius: 2px;
    background: #fff;
    box-shadow: 0 12px 26px rgba(14, 41, 52, 0.15);
    padding: 1.25rem;
  }

  .contact-card__badge {
    color: #f1644f;
    line-height: 0;
  }

  .contact-card__badge svg {
    width: 40px;
    height: auto;
    fill: currentColor;
  }

  .contact-card__body {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
  }

  .contact-card__role {
    margin: 0;
    color: #399da3;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.2;
    min-height: 2rem;
    white-space: pre-line;
  }

  .contact-card__identity {
    display: grid;
    gap: 0.45rem;
    margin-top: auto;
  }

  .contact-card__name {
    margin: 0;
    color: #666;
    font-weight: 700;
    line-height: 1.25;
  }

  .contact-card__details {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    color: #666;
  }

  .contact-card__details div {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem;
  }

  .contact-card__details dt {
    line-height: 0;
  }

  .contact-card__details svg {
    width: 21px;
    height: 21px;
    fill: #2b7181;
  }

  .contact-card__details dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .contact-card__details a {
    color: #2d6070;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }
</style>
