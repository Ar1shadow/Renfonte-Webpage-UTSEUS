---
// src/components/Header.astro
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';
interface Props { lang?: Lang; }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="site-header__utility">
    <div class="site-header__utility-inner">
      <a class="site-header__utility-flag" href="https://www.utc.fr/utc/lutc-en-bref/ukraine/" target="_blank" rel="noopener" aria-label="Ukraine">
        <img src={`${base}images/header/drapeau-ukraine.jpg`} alt="" />
      </a>
      <a class="site-header__utility-link" href="https://interactions.utc.fr" target="_blank" rel="noopener">
        <svg class="site-header__utility-icon" viewBox="0 0 32 28" aria-hidden="true"><path d="M16 8h-6v6h6v-6zM18 18v2h-10v-2h10zM18 6v10h-10v-10h10zM28 18v2h-8v-2h8zM28 14v2h-8v-2h8zM28 10v2h-8v-2h8zM28 6v2h-8v-2h8zM4 21v-15h-2v15c0 0.547 0.453 1 1 1s1-0.453 1-1zM30 21v-17h-24v17c0 0.344-0.063 0.688-0.172 1h23.172c0.547 0 1-0.453 1-1zM32 2v19c0 1.656-1.344 3-3 3h-26c-1.656 0-3-1.344-3-3v-17h4v-2h28z"/></svg>
        <span>Magazine Interactions</span>
      </a>
      <a class="site-header__utility-link" href="https://www.utc.fr/inscription-a-la-newsletter/" target="_blank" rel="noopener">
        <svg class="site-header__utility-icon" viewBox="0 0 28 28" aria-hidden="true"><path d="M28 11.094v12.406c0 1.375-1.125 2.5-2.5 2.5h-23c-1.375 0-2.5-1.125-2.5-2.5v-12.406c0.469 0.516 1 0.969 1.578 1.359 2.594 1.766 5.219 3.531 7.766 5.391 1.313 0.969 2.938 2.156 4.641 2.156h0.031c1.703 0 3.328-1.188 4.641-2.156 2.547-1.844 5.172-3.625 7.781-5.391 0.562-0.391 1.094-0.844 1.563-1.359zM28 6.5c0 1.75-1.297 3.328-2.672 4.281-2.438 1.687-4.891 3.375-7.313 5.078-1.016 0.703-2.734 2.141-4 2.141h-0.031c-1.266 0-2.984-1.437-4-2.141-2.422-1.703-4.875-3.391-7.297-5.078-1.109-0.75-2.688-2.516-2.688-3.938 0-1.531 0.828-2.844 2.5-2.844h23c1.359 0 2.5 1.125 2.5 2.5z"/></svg>
        <span>Newsletter</span>
      </a>
      <a class="site-header__utility-link" href="https://www.utc.fr/utc/lutc-en-bref/un-modele-innovant/la-fondation-utc-pour-linnovation/" target="_blank" rel="noopener">
        <svg class="site-header__utility-icon" viewBox="0 0 30 28" aria-hidden="true"><path d="M15 0l15 6v2h-2c0 0.547-0.484 1-1.078 1h-23.844c-0.594 0-1.078-0.453-1.078-1h-2v-2zM4 10h4v12h2v-12h4v12h2v-12h4v12h2v-12h4v12h0.922c0.594 0 1.078 0.453 1.078 1v1h-26v-1c0-0.547 0.484-1 1.078-1h0.922v-12zM28.922 25c0.594 0 1.078 0.453 1.078 1v2h-30v-2c0-0.547 0.484-1 1.078-1h27.844z"/></svg>
        <span>FONDATION</span>
      </a>
      <a class="site-header__utility-link" href="https://ent.utc.fr" target="_blank" rel="noopener">
        <svg class="site-header__utility-icon" viewBox="0 0 20 28" aria-hidden="true"><path d="M20 21.859c0 2.281-1.5 4.141-3.328 4.141h-13.344c-1.828 0-3.328-1.859-3.328-4.141 0-4.109 1.016-8.859 5.109-8.859 1.266 1.234 2.984 2 4.891 2s3.625-0.766 4.891-2c4.094 0 5.109 4.75 5.109 8.859zM16 8c0 3.313-2.688 6-6 6s-6-2.688-6-6 2.688-6 6-6 6 2.688 6 6z"/></svg>
        <span>ent</span>
      </a>
      <a class="site-header__utility-link site-header__utility-link--icon-only" href="#" aria-label="Search">
        <svg class="site-header__utility-icon" viewBox="0 0 26 28" aria-hidden="true"><path d="M18 13c0-3.859-3.141-7-7-7s-7 3.141-7 7 3.141 7 7 7 7-3.141 7-7zM26 26c0 1.094-0.906 2-2 2-0.531 0-1.047-0.219-1.406-0.594l-5.359-5.344c-1.828 1.266-4.016 1.937-6.234 1.937-6.078 0-11-4.922-11-11s4.922-11 11-11 11 4.922 11 11c0 2.219-0.672 4.406-1.937 6.234l5.359 5.359c0.359 0.359 0.578 0.875 0.578 1.406z"/></svg>
      </a>
    </div>
  </div>
  <div class="site-header__inner">
    <a href={`/${lang}/`} class="site-header__brand" aria-label="UTSEUS home">
      <img class="site-header__logo" src={`${base}images/brand/utseus-logo.png`} alt="UTSEUS" width="1463" height="569" />
    </a>
    <nav aria-label="Main" class="site-header__nav">
      <ul>
        <li><a href="#about">{t('nav.about')}</a></li>
        <li><a href="#mobility">{t('nav.mobility')}</a></li>
        <li><a href="#complexcity">{t('nav.complexcity')}</a></li>
        <li><a href="#projects">{t('nav.projects')}</a></li>
        <li><a href="#testimonials">{t('nav.testimonials')}</a></li>
        <li><a href="#contact">{t('nav.contact')}</a></li>
      </ul>
    </nav>
    <div class="site-header__actions">
      <LangSwitcher current={lang} />
    </div>
  </div>
</header>
