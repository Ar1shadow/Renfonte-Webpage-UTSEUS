---
// src/components/Header.astro
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';
interface Props { lang?: Lang; }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="site-header__inner">
    <a href={`/${lang}/`} class="site-header__brand" aria-label="UTSEUS home">
      <img class="site-header__logo" src={`${base}images/brand/utseus-logo.png`} alt="UTSEUS" width="1463" height="569" />
    </a>
    <nav aria-label="Main" class="site-header__nav">
      <ul>
        <li><a href="#about">{t('nav.about')}</a></li>
        <li><a href="#courses">{t('nav.courses')}</a></li>
        <li><a href="#campuslife">{t('nav.campuslife')}</a></li>
        <li><a href="#partners">{t('nav.partners')}</a></li>
        <li><a href="#testimonials">{t('nav.testimonials')}</a></li>
        <li><a href="#contact">{t('nav.contact')}</a></li>
      </ul>
    </nav>
    <div class="site-header__actions">
      <LangSwitcher current={lang} />
    </div>
  </div>
</header>
