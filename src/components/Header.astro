---
// src/components/Header.astro
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';
interface Props { lang?: Lang; }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---
<header class="site-header">
  <div class="site-header__inner">
    <a href={`/${lang}/`} class="site-header__brand" aria-label="UTSEUS home">
      <span class="site-header__mark" aria-hidden="true">U</span>
      <span>
        <span class="site-header__name">UTSEUS</span>
        <span class="site-header__sub">Shanghai × Réseau UT</span>
      </span>
    </a>
    <nav aria-label="Main" class="site-header__nav">
      <ul>
        <li><a href="#about">{t('nav.about')}</a></li>
        <li><a href="#mobility">{t('nav.mobility')}</a></li>
        <li><a href="#complexcity">{t('nav.complexcity')}</a></li>
        <li><a href="#projects">{t('nav.projects')}</a></li>
        <li><a href="#testimonials">{t('nav.testimonials')}</a></li>
        <li><a href="#contact">{t('nav.contact')}</a></li>
      </ul>
    </nav>
    <div class="site-header__actions">
      <LangSwitcher current={lang} />
      <a href="/docs/brochure-utseus.pdf" class="site-header__cta">{t('cta.brochure')}</a>
    </div>
  </div>
</header>
