---
import type { Lang } from '../i18n/ui';
interface ProjectData {
  slug: string;
  title: { en: string; fr: string; zh: string };
  description: { en: string; fr: string; zh: string };
  axis: 'modeling' | 'safety' | 'logistics' | 'smart-buildings' | 'culture';
  image: string;
  links?: { label: string; url: string }[];
}
interface Props { project: ProjectData; lang: Lang; index: number; }
const { project, lang, index } = Astro.props;
const axisLabel = project.axis.replace('-', ' ');
const fallbackIcons = [
  '/images/icons/generated/project-smart-city.png',
  '/images/icons/generated/project-urban-logistics.png',
  '/images/icons/generated/project-building-energy.png',
  '/images/icons/generated/project-safety-risk.png',
  '/images/icons/generated/project-health-aging.png',
  '/images/icons/generated/project-water-waste.png',
  '/images/icons/generated/project-data-modeling.png',
  '/images/icons/generated/project-sustainable-mobility.png',
  '/images/icons/generated/project-digital-culture.png',
  '/images/icons/generated/project-connected-infrastructure.png',
];
const projectIconMap: Record<string, string> = {
  'traffic-models': '/images/icons/generated/project-sustainable-mobility.png',
  'camera-sensor-monitoring': '/images/icons/generated/project-safety-risk.png',
  'engineering-modeling': '/images/icons/generated/project-data-modeling.png',
  'sustainable-practices': '/images/icons/generated/project-smart-city.png',
  'smart-city-logistics': '/images/icons/generated/project-urban-logistics.png',
  'health-surveillance': '/images/icons/generated/project-health-aging.png',
  'audio-scenes': '/images/icons/generated/project-safety-risk.png',
  'building-life-cycle': '/images/icons/generated/project-building-energy.png',
  'web-mobility-data': '/images/icons/generated/project-data-modeling.png',
  dynamicity: '/images/icons/generated/project-connected-infrastructure.png',
  'urban-metabolism': '/images/icons/generated/project-water-waste.png',
  'digital-eternity': '/images/icons/generated/project-digital-culture.png',
  'smart-building-energy': '/images/icons/generated/project-building-energy.png',
  'urban-comfort': '/images/icons/generated/project-building-energy.png',
};
const iconSrc = projectIconMap[project.slug] ?? fallbackIcons[index % fallbackIcons.length];
---
<div class="project-card group" data-project={project.slug} tabindex="0" role="button" aria-label={project.title[lang]}>
  <figure class="project-illustration project-illustration--icon">
    <span class="project-illustration__circuit" aria-hidden="true"></span>
    <img src={iconSrc} alt="" loading="lazy" />
  </figure>
  <div class="project-card__body">
    <p class="project-card__axis">{axisLabel}</p>
    <h3>{project.title[lang]}</h3>
    <p>{project.description[lang]}</p>
  </div>
</div>
