---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const items = await getCollection('testimonials');

const initials = (name: string) => name
  .split(' ')
  .filter(Boolean)
  .map(part => part[0])
  .join('');
---
<div class="testimonial-carousel relative">
  <ol class="testimonial-carousel__track flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 scroll-smooth" aria-label="Student testimonials" tabindex="0">
    {items.map(t => (
      <li class="testimonial-card snap-start shrink-0 w-[84vw] md:w-[520px]">
        <div class="testimonial-card__visual" aria-hidden="true"></div>
        <div class="testimonial-card__body">
          <div class="testimonial-card__header">
            <div class="testimonial-card__initials" aria-hidden="true">
              {initials(t.data.name)}
            </div>
            <div class="testimonial-card__identity">
              <p class="testimonial-card__name">{t.data.name}</p>
              <p class="testimonial-card__meta">{t.data.promo} · {t.data.program} · {t.data.year}</p>
            </div>
          </div>
          <blockquote class="testimonial-card__quote">
            <span class="testimonial-card__quote-mark" aria-hidden="true">“</span>
            <span>{t.data.quote[lang]}</span>
          </blockquote>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .testimonial-carousel {
    margin-top: 0.5rem;
  }

  .testimonial-carousel__track {
    scrollbar-width: thin;
    scrollbar-color: rgba(210, 31, 70, 0.36) transparent;
  }

  .testimonial-card {
    position: relative;
    display: block;
    min-height: 18rem;
    overflow: hidden;
    border: 1px solid rgba(23, 54, 93, 0.12);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: 0 18px 44px rgba(23, 54, 93, 0.11);
  }

  .testimonial-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgba(210, 31, 70, 0.12), transparent 30%),
      linear-gradient(315deg, rgba(244, 200, 77, 0.18), transparent 32%);
    opacity: 0.72;
  }

  .testimonial-card__visual {
    position: absolute;
    top: 0;
    right: 0;
    width: 42%;
    height: 100%;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0), #fff 88%),
      linear-gradient(135deg, rgba(23, 54, 93, 0.1) 0 12%, transparent 12% 100%),
      repeating-linear-gradient(90deg, rgba(23, 54, 93, 0.16) 0 1px, transparent 1px 18px),
      repeating-linear-gradient(0deg, rgba(23, 54, 93, 0.08) 0 1px, transparent 1px 22px),
      linear-gradient(135deg, rgba(210, 31, 70, 0.12), rgba(244, 200, 77, 0.18));
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
  }

  .testimonial-card__visual::before,
  .testimonial-card__visual::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .testimonial-card__visual::before {
    left: 22%;
    top: 18%;
    width: 58%;
    height: 50%;
    border: 1px solid rgba(23, 54, 93, 0.16);
    border-right-width: 5px;
    background:
      repeating-linear-gradient(90deg, transparent 0 12px, rgba(255, 255, 255, 0.5) 12px 16px),
      rgba(255, 255, 255, 0.28);
  }

  .testimonial-card__visual::after {
    right: 12%;
    bottom: 18%;
    width: 54%;
    height: 0.42rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-yellow));
    opacity: 0.72;
  }

  .testimonial-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-width: 0;
    max-width: 76%;
    padding: 1.55rem 1.65rem 1.65rem;
  }

  .testimonial-card__header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  .testimonial-card__initials {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 3.35rem;
    height: 3.35rem;
    border: 1px solid rgba(210, 31, 70, 0.2);
    border-radius: 999px;
    background: rgba(210, 31, 70, 0.08);
    color: var(--color-accent);
    font-family: var(--font-display, inherit);
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    box-shadow: none;
  }

  .testimonial-card__identity {
    min-width: 0;
  }

  .testimonial-card__name {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-display, inherit);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .testimonial-card__meta {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 1.75rem;
    margin: 0.45rem 0 0;
    padding: 0.32rem 0.7rem;
    border: 1px solid rgba(23, 54, 93, 0.1);
    border-radius: 999px;
    background: rgba(23, 54, 93, 0.045);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .testimonial-card__quote {
    position: relative;
    margin: 0;
    padding-left: 2.3rem;
    color: var(--color-fg);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .testimonial-card__quote::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.35rem;
    bottom: 0.25rem;
    width: 0.22rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--color-accent), var(--color-yellow));
  }

  .testimonial-card__quote-mark {
    position: absolute;
    left: 0.38rem;
    top: -0.75rem;
    color: rgba(210, 31, 70, 0.18);
    font-family: Georgia, serif;
    font-size: 4rem;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .testimonial-card {
      min-height: 0;
    }

    .testimonial-card__visual {
      position: relative;
      width: 100%;
      height: 5.75rem;
      clip-path: none;
    }

    .testimonial-card__body {
      max-width: none;
      padding: 1.25rem;
    }

    .testimonial-card__meta {
      white-space: normal;
    }

    .testimonial-card__quote {
      padding-left: 1.7rem;
      font-size: 0.98rem;
    }
  }
</style>
