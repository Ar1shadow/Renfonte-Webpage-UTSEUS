---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const readMore = t('testimonial.readMore');
const readLess = t('testimonial.readLess');
const items = await getCollection('testimonials');

const initials = (name: string) => name
  .split(' ')
  .filter(Boolean)
  .map(part => part[0])
  .join('');
---
<div class="testimonial-carousel relative">
  <ol class="testimonial-carousel__track flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 scroll-smooth" aria-label="Student testimonials" tabindex="0">
    {items.map(t => (
      <li class="testimonial-card snap-start shrink-0 w-[84vw] md:w-[520px]">
        <div class="testimonial-card__visual" aria-hidden="true"></div>
        <div class="testimonial-card__body">
          <div class="testimonial-card__header">
            <div class="testimonial-card__initials" aria-hidden="true">
              {initials(t.data.name)}
            </div>
            <div class="testimonial-card__identity">
              <p class="testimonial-card__name">{t.data.name}</p>
              <p class="testimonial-card__meta">{t.data.promo} · {t.data.program} · {t.data.year}</p>
            </div>
          </div>
          <blockquote
            class="testimonial-card__quote is-collapsed"
            tabindex="0"
            role="region"
            aria-label="Quote"
          >
            <span class="testimonial-card__quote-mark" aria-hidden="true">“</span>
            <span class="testimonial-card__quote-text">{t.data.quote[lang]}</span>
          </blockquote>
          <button
            type="button"
            class="testimonial-card__toggle"
            aria-expanded="false"
            data-more={readMore}
            data-less={readLess}
          >
            {readMore}
          </button>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.testimonial-card');
  cards.forEach(card => {
    const quote = card.querySelector<HTMLElement>('.testimonial-card__quote');
    const toggle = card.querySelector<HTMLButtonElement>('.testimonial-card__toggle');
    if (!quote || !toggle) return;

    const textEl = quote.querySelector<HTMLElement>('.testimonial-card__quote-text');

    const updateVisibility = () => {
      const isMobile = window.matchMedia('(max-width: 640px)').matches;
      if (!isMobile || !textEl) {
        toggle.hidden = true;
        quote.classList.remove('is-collapsed');
        return;
      }
      const wasCollapsed = quote.classList.contains('is-collapsed');
      quote.classList.add('is-collapsed');
      const overflows = textEl.scrollHeight > textEl.clientHeight + 1;
      quote.classList.toggle('is-collapsed', overflows && wasCollapsed);
      toggle.hidden = !overflows;
      toggle.setAttribute('aria-expanded', String(!quote.classList.contains('is-collapsed')));
      toggle.textContent = quote.classList.contains('is-collapsed')
        ? toggle.dataset.more ?? ''
        : toggle.dataset.less ?? '';
    };

    toggle.addEventListener('click', () => {
      const collapsed = quote.classList.toggle('is-collapsed');
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.textContent = collapsed ? toggle.dataset.more ?? '' : toggle.dataset.less ?? '';
    });

    updateVisibility();
    window.addEventListener('resize', updateVisibility);
  });
</script>

<style>
  .testimonial-carousel {
    margin-top: 0.5rem;
  }

  .testimonial-carousel__track {
    scrollbar-width: thin;
    scrollbar-color: rgba(210, 31, 70, 0.36) transparent;
  }

  .testimonial-card {
    position: relative;
    display: block;
    height: 22rem;
    overflow: hidden;
    border: 1px solid rgba(23, 54, 93, 0.12);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: 0 18px 44px rgba(23, 54, 93, 0.11);
  }

  .testimonial-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgba(210, 31, 70, 0.12), transparent 30%),
      linear-gradient(315deg, rgba(244, 200, 77, 0.18), transparent 32%);
    opacity: 0.72;
  }

  .testimonial-card__visual {
    position: absolute;
    top: 0;
    right: 0;
    width: 42%;
    height: 100%;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0), #fff 88%),
      linear-gradient(135deg, rgba(23, 54, 93, 0.1) 0 12%, transparent 12% 100%),
      repeating-linear-gradient(90deg, rgba(23, 54, 93, 0.16) 0 1px, transparent 1px 18px),
      repeating-linear-gradient(0deg, rgba(23, 54, 93, 0.08) 0 1px, transparent 1px 22px),
      linear-gradient(135deg, rgba(210, 31, 70, 0.12), rgba(244, 200, 77, 0.18));
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
  }

  .testimonial-card__visual::before,
  .testimonial-card__visual::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .testimonial-card__visual::before {
    left: 22%;
    top: 18%;
    width: 58%;
    height: 50%;
    border: 1px solid rgba(23, 54, 93, 0.16);
    border-right-width: 5px;
    background:
      repeating-linear-gradient(90deg, transparent 0 12px, rgba(255, 255, 255, 0.5) 12px 16px),
      rgba(255, 255, 255, 0.28);
  }

  .testimonial-card__visual::after {
    right: 12%;
    bottom: 18%;
    width: 54%;
    height: 0.42rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-yellow));
    opacity: 0.72;
  }

  .testimonial-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-width: 0;
    max-width: 76%;
    padding: 1.55rem 1.65rem 1.65rem;
  }

  .testimonial-card__header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  .testimonial-card__initials {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 3.35rem;
    height: 3.35rem;
    border: 1px solid rgba(210, 31, 70, 0.2);
    border-radius: 999px;
    background: rgba(210, 31, 70, 0.08);
    color: var(--color-accent);
    font-family: var(--font-display, inherit);
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    box-shadow: none;
  }

  .testimonial-card__identity {
    min-width: 0;
  }

  .testimonial-card__name {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-display, inherit);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .testimonial-card__meta {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 1.75rem;
    margin: 0.45rem 0 0;
    padding: 0.32rem 0.7rem;
    border: 1px solid rgba(23, 54, 93, 0.1);
    border-radius: 999px;
    background: rgba(23, 54, 93, 0.045);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .testimonial-card__quote {
    position: relative;
    margin: 0;
    padding-left: 2.3rem;
    padding-right: 0.4rem;
    max-height: 14rem;
    overflow-y: auto;
    color: var(--color-fg);
    font-size: 1.02rem;
    line-height: 1.75;
    scrollbar-width: thin;
    scrollbar-color: rgba(210, 31, 70, 0.36) transparent;
  }

  .testimonial-card__quote:focus-visible {
    outline: 2px solid rgba(210, 31, 70, 0.45);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .testimonial-card__quote::-webkit-scrollbar {
    width: 6px;
  }

  .testimonial-card__quote::-webkit-scrollbar-thumb {
    background: rgba(210, 31, 70, 0.36);
    border-radius: 999px;
  }

  .testimonial-card__quote::-webkit-scrollbar-track {
    background: transparent;
  }

  .testimonial-card__toggle {
    display: none;
  }

  .testimonial-card__quote::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.35rem;
    bottom: 0.25rem;
    width: 0.22rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--color-accent), var(--color-yellow));
  }

  .testimonial-card__quote-mark {
    position: absolute;
    left: 0.38rem;
    top: -0.75rem;
    color: rgba(210, 31, 70, 0.18);
    font-family: Georgia, serif;
    font-size: 4rem;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .testimonial-card {
      height: auto;
      min-height: 0;
    }

    .testimonial-card__visual {
      position: relative;
      width: 100%;
      height: 5.75rem;
      clip-path: none;
    }

    .testimonial-card__body {
      max-width: none;
      padding: 1.25rem;
    }

    .testimonial-card__meta {
      white-space: normal;
    }

    .testimonial-card__quote {
      padding-left: 1.7rem;
      font-size: 0.98rem;
      max-height: none;
      overflow-y: visible;
    }

    .testimonial-card__quote.is-collapsed .testimonial-card__quote-text {
      display: -webkit-box;
      -webkit-line-clamp: 4;
      line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .testimonial-card__toggle {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      margin-top: -0.6rem;
      padding: 0.3rem 0.1rem;
      border: 0;
      background: transparent;
      color: var(--color-accent);
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
    }

    .testimonial-card__toggle[hidden] {
      display: none;
    }

    .testimonial-card__toggle:focus-visible {
      outline: 2px solid rgba(210, 31, 70, 0.45);
      outline-offset: 2px;
      border-radius: 4px;
    }
  }
</style>
