---
import type { Lang } from '../i18n/ui';
interface ProgramData {
  audience: 'chinese-students' | 'incoming-students';
  title: { en: string; fr: string; zh: string };
  description: { en: string; fr: string; zh: string };
  duration: string;
  icon?: string;
}
interface Props { program: ProgramData; lang: Lang; }
const { program, lang } = Astro.props;
const copy = {
  en: {
    audience: 'Audience',
    chineseAudience: 'Chinese students',
    incomingAudience: 'Incoming exchange students',
  },
  fr: {
    audience: 'Public',
    chineseAudience: 'Étudiants chinois',
    incomingAudience: 'Étudiants en mobilité entrante',
  },
  zh: {
    audience: '对象',
    chineseAudience: '中国学生',
    incomingAudience: '来沪交换生',
  },
}[lang];
const isChineseAudience = program.audience === 'chinese-students';
const audience = isChineseAudience ? copy.chineseAudience : copy.incomingAudience;
const logoSrc = isChineseAudience ? '/images/brand/logo-shu-transparent.png' : '/images/brand/logo-utc-transparent.png';
const logoAlt = isChineseAudience ? 'Shanghai University' : 'Université de technologie de Compiègne';
---
<article class={`program-card program-card--${program.audience}`} data-audience={program.audience}>
  <div class="program-card__visual" aria-hidden="true">
    <img src={logoSrc} alt={logoAlt} loading="lazy" />
  </div>
  <div class="program-card__body">
    <p class="program-card__audience">{audience}</p>
    <h3>{program.title[lang]}</h3>
    <p class="program-card__description">{program.description[lang]}</p>
  </div>
</article>
