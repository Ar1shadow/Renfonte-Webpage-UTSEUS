---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const projects = await getCollection('projects');
const projectsData = projects.map((p, index) => ({ ...p.data, index }));
---
<div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
  {projects.map((p, index) => <ProjectCard project={p.data} lang={lang} index={index} />)}
</div>

<dialog id="project-dialog" class="rounded-md p-0 backdrop:bg-black/40 max-w-2xl w-[90vw]">
  <article class="p-6">
    <button id="dialog-close" class="float-right text-xl" aria-label="Close">×</button>
    <div id="dialog-visual" class="research-card-visual research-card-visual--modeling rounded" aria-hidden="true">
      <span class="research-card-visual__index"></span>
      <span class="research-card-visual__axis"></span>
    </div>
    <h3 id="dialog-title" class="text-2xl font-bold mt-4"></h3>
    <p id="dialog-desc" class="mt-2 text-base"></p>
    <ul id="dialog-links" class="mt-4 text-sm"></ul>
  </article>
</dialog>

<script define:vars={{ projectsData, lang }}>
  const dlg = /** @type {HTMLDialogElement} */ (document.getElementById('project-dialog'));
  const close = document.getElementById('dialog-close');
  if (dlg && close) {
    close.addEventListener('click', () => dlg.close());
    document.querySelectorAll('[data-project]').forEach(card => {
      const open = () => {
        const slug = card.getAttribute('data-project');
        const p = projectsData.find(x => x.slug === slug);
        if (!p) return;
        const visual = document.getElementById('dialog-visual');
        const visualIndex = visual?.querySelector('.research-card-visual__index');
        const visualAxis = visual?.querySelector('.research-card-visual__axis');
        const title = document.getElementById('dialog-title');
        const desc = document.getElementById('dialog-desc');
        const linksEl = document.getElementById('dialog-links');
        if (!visual || !visualIndex || !visualAxis || !title || !desc || !linksEl) return;
        visual.className = `research-card-visual research-card-visual--${p.axis} rounded`;
        visualIndex.textContent = String(p.index + 1).padStart(2, '0');
        visualAxis.textContent = p.axis.replace('-', ' ');
        title.textContent = p.title[lang];
        desc.textContent = p.description[lang];
        linksEl.innerHTML = '';
        (p.links || []).forEach(l => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = l.url;
          a.textContent = l.label;
          a.className = 'text-accent underline';
          a.rel = 'noopener';
          a.target = '_blank';
          li.appendChild(a);
          linksEl.appendChild(li);
        });
        dlg.showModal();
      };
      card.addEventListener('click', open);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });
  }
</script>
