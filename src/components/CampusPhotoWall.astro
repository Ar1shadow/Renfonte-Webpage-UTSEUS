---
import { readdirSync } from 'node:fs';
import { extname, join, parse } from 'node:path';

const photoFolder = "vie d'etudient";
const photoDir = join(process.cwd(), 'public', 'images', photoFolder);
const supportedPhotoExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.avif']);
const photos = readdirSync(photoDir)
  .filter((file) => supportedPhotoExtensions.has(extname(file).toLowerCase()))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((file) => {
    const label = parse(file).name;
    return {
      src: `/images/${photoFolder}/${file}`,
      alt: `UTSEUS student life photo ${label}`,
    };
  });
const loopPhotos = [...photos, ...photos];
---

<section class="campus-photo-wall" aria-label="Campus life photo wall" data-campus-photo-wall>
  <button class="campus-photo-wall__nav campus-photo-wall__nav--prev" type="button" aria-label="Previous photo" data-campus-photo-prev>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div class="campus-photo-wall__viewport" data-campus-photo-viewport>
    <div class="campus-photo-wall__track" data-campus-photo-track>
      {loopPhotos.map((photo, index) => (
        <figure class="campus-photo-wall__card" aria-hidden={index >= photos.length ? 'true' : undefined}>
          <img src={photo.src} alt={index >= photos.length ? '' : photo.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
  <button class="campus-photo-wall__nav campus-photo-wall__nav--next" type="button" aria-label="Next photo" data-campus-photo-next>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</section>

<script>
  const PX_PER_SECOND = 34;
  const RESUME_DELAY_MS = 180;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-campus-photo-wall]').forEach((wall) => {
    const track = wall.querySelector<HTMLElement>('[data-campus-photo-track]');
    const prev = wall.querySelector<HTMLButtonElement>('[data-campus-photo-prev]');
    const next = wall.querySelector<HTMLButtonElement>('[data-campus-photo-next]');
    if (!track || !prev || !next) return;

    let offset = 0;
    let paused = prefersReduced;
    let resumeTimer: number | null = null;
    let lastTs = 0;
    let halfWidth = 0;
    let nudgeFrame: number | null = null;

    const measure = () => {
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.campus-photo-wall__card'));
      const midpoint = cards.length / 2;
      const first = cards[0];
      const secondSetFirst = cards[midpoint];
      halfWidth = first && secondSetFirst
        ? secondSetFirst.offsetLeft - first.offsetLeft
        : track.scrollWidth / 2;
    };

    const apply = () => {
      track.style.transform = `translateX(${-offset}px)`;
    };

    const itemStep = () => {
      const first = track.querySelector<HTMLElement>('.campus-photo-wall__card');
      if (!first) return 360;
      const style = getComputedStyle(track);
      const gap = parseFloat(style.columnGap || style.gap || '0') || 0;
      return first.getBoundingClientRect().width + gap;
    };

    const wrap = (value: number) => {
      if (!halfWidth) return value;
      let nextOffset = value % halfWidth;
      if (nextOffset < 0) nextOffset += halfWidth;
      return nextOffset;
    };

    const stepFn = (ts: number) => {
      if (!lastTs) lastTs = ts;
      const dt = (ts - lastTs) / 1000;
      lastTs = ts;
      if (!paused && halfWidth && nudgeFrame === null) {
        offset = wrap(offset + PX_PER_SECOND * dt);
        apply();
      }
      requestAnimationFrame(stepFn);
    };

    const nudge = (direction: 1 | -1) => {
      const stepPx = itemStep();
      if (!halfWidth) return;
      paused = true;
      if (nudgeFrame !== null) {
        window.cancelAnimationFrame(nudgeFrame);
        nudgeFrame = null;
      }
      if (direction < 0 && offset - stepPx < 0) {
        offset += halfWidth;
        apply();
      }
      const from = offset;
      const to = offset + direction * stepPx;
      const duration = prefersReduced ? 0 : 320;
      const startedAt = performance.now();
      const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
      const animate = (ts: number) => {
        const progress = duration === 0 ? 1 : Math.min(1, (ts - startedAt) / duration);
        offset = from + (to - from) * easeOutCubic(progress);
        apply();
        if (progress < 1) {
          nudgeFrame = window.requestAnimationFrame(animate);
        } else {
          nudgeFrame = null;
          offset = wrap(to);
          apply();
          paused = prefersReduced;
        }
      };
      nudgeFrame = window.requestAnimationFrame(animate);
      if (resumeTimer) window.clearTimeout(resumeTimer);
      resumeTimer = null;
    };

    prev.addEventListener('click', () => nudge(-1));
    next.addEventListener('click', () => nudge(1));

    wall.addEventListener('mouseenter', () => { paused = true; });
    wall.addEventListener('mouseleave', () => {
      if (resumeTimer) { window.clearTimeout(resumeTimer); resumeTimer = null; }
      paused = prefersReduced;
    });
    wall.addEventListener('touchstart', () => { paused = true; }, { passive: true });
    wall.addEventListener('touchend', () => {
      if (resumeTimer) window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => { paused = prefersReduced; }, RESUME_DELAY_MS);
    }, { passive: true });

    window.addEventListener('resize', measure);

    const imgs = Array.from(track.querySelectorAll('img')) as HTMLImageElement[];
    if (imgs.length === 0) {
      measure();
    } else {
      Promise.all(
        imgs.map((img) =>
          !img.complete
            ? new Promise<void>((resolve) => {
                img.addEventListener('load', () => resolve(), { once: true });
                img.addEventListener('error', () => resolve(), { once: true });
              })
            : Promise.resolve(),
        ),
      ).then(measure);
      measure();
    }

    requestAnimationFrame(stepFn);
  });
</script>

<style>
  .campus-photo-wall {
    position: relative;
    margin-top: 2rem;
  }

  .campus-photo-wall__viewport {
    overflow: hidden;
    overflow-y: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
  }

  .campus-photo-wall__track {
    display: flex;
    width: max-content;
    gap: 1.5rem;
    padding: 0.25rem 0.25rem 0.75rem;
    will-change: transform;
    transition: none;
  }

  .campus-photo-wall__card {
    flex: 0 0 clamp(18rem, 31vw, 28rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(23, 54, 93, 0.12);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: 0 18px 44px rgba(23, 54, 93, 0.13);
  }

  .campus-photo-wall__card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
  }

  .campus-photo-wall__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border: 1px solid rgba(23, 54, 93, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    color: var(--color-heading);
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 10px 26px rgba(23, 54, 93, 0.18);
  }

  .campus-photo-wall__nav:hover {
    color: var(--color-accent);
  }

  .campus-photo-wall__nav svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .campus-photo-wall__nav--prev {
    left: 0;
  }

  .campus-photo-wall__nav--next {
    right: 0;
  }

  @media (max-width: 640px) {
    .campus-photo-wall__track {
      gap: 1rem;
    }

    .campus-photo-wall__card {
      flex-basis: min(78vw, 22rem);
    }

    .campus-photo-wall__nav {
      width: 2.8rem;
      height: 2.8rem;
    }
  }
</style>
