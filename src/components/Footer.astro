---
import type { Lang } from '../i18n/ui';
interface Props { lang?: Lang; }
const { lang: _lang = 'fr' } = Astro.props;
const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}images/footer/${name}`;
---
<footer id="leFooter" class="utc-footer">
  <section class="utc-footer__top">
    <div class="utc-footer__col utc-footer__col--org">
      <h2 class="utc-footer__title">UTC</h2>
      <div class="utc-footer__title2">université de technologie de Compiègne</div>
      <div class="utc-footer__addr">
        Rue du docteur Schweitzer CS 60319<br />
        60203 Compiègne Cedex France<br />
        Tél : +33 3 44 23 44 23
      </div>
      <div class="utc-footer__logos">
        <img src={img('logo-utc-footer.png')} alt="logo utc" />
        <img src={img('logo-hauts-de-france.png')} alt="hauts-de-france" />
        <a href="https://www.utc.fr/utc/lutc-en-bref/un-modele-innovant/charte-europeenne-du-chercheur/">
          <img src={img('logo-hr.png')} alt="Excellence Research" />
        </a>
      </div>
    </div>

    <nav class="utc-footer__col utc-footer__col--nav" aria-label="Footer menu 1">
      <ul>
        <li><a href="https://www.utc.fr/en/actes-reglementaires/">Actes réglementaires</a></li>
        <li><a href="https://www.utc.fr/en/amicale-de-lutc/">Amicale de l'UTC</a></li>
        <li><a href="http://bibliotheque.utc.fr/EXPLOITATION/">Bibliothèque</a></li>
        <li><a href="https://www.utc.fr/wp-content/uploads/sites/28/2021/04/charte-erasmus-2021-27-signee.pdf">Charte Erasmus+ 2021–2027</a></li>
        <li><a href="https://www.utc.fr/en/contactez-nous/">Contactez-nous</a></li>
        <li><a href="https://www.utc.fr/en/epidemie-de-coronavirus/">Épidémie de coronavirus</a></li>
        <li><a href="https://www.utc.fr/en/documentation/">Documentation</a></li>
        <li><a href="https://ent.utc.fr">ENT</a></li>
        <li><a href="https://fetedelascience.utc.fr/">Fête de la science</a></li>
        <li><a href="https://interactions.utc.fr/">Interactions – Le magazine</a></li>
      </ul>
    </nav>

    <nav class="utc-footer__col utc-footer__col--nav" aria-label="Footer menu 2">
      <ul>
        <li><a href="https://www.utc.fr/en/marches-publics/">Marchés publics</a></li>
        <li><a href="https://www.utc.fr/wp-content/uploads/sites/28/2022/03/organigramme-general-1.pdf">Organigramme</a></li>
        <li><a href="https://www.utc.fr/en/presse/">Presse</a></li>
        <li><a href="http://prixroberval.utc.fr/">Prix Roberval</a></li>
        <li><a href="https://www.utc.fr/en/recrutement/">Recrutement</a></li>
        <li><a href="https://www.utc.fr/utc/la-vie-etudiante/relais-handicap-etudiants/">The disabled Students Bureau</a></li>
        <li><a href="https://www.utc.fr/wp-content/uploads/sites/28/2025/09/salons-utc-2025-2026.pdf">Salons</a></li>
        <li><a href="https://www.utc.fr/en/taxe-dapprentissage/">Taxe d'apprentissage</a></li>
        <li><a href="https://www.alumni.utc.fr/">UTC Alumni</a></li>
        <li><a href="http://www.uteam.fr/">UTeam</a></li>
      </ul>
    </nav>
  </section>

  <section class="utc-footer__mid">
    <div class="utc-footer__social">
      <a href="https://www.facebook.com/utcompiegne/" target="_blank" rel="noopener" aria-label="Facebook">
