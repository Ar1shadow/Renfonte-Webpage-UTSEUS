      </a>
      <a href="https://www.linkedin.com/school/universit-de-technologie-de-compi-gne/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 24 28" aria-hidden="true"><path d="M3.703 22.094h3.609v-10.844h-3.609v10.844zM7.547 7.906c-0.016-1.062-0.781-1.875-2.016-1.875s-2.047 0.812-2.047 1.875c0 1.031 0.781 1.875 2 1.875h0.016c1.266 0 2.047-0.844 2.047-1.875zM16.688 22.094h3.609v-6.219c0-3.328-1.781-4.875-4.156-4.875-1.937 0-2.797 1.078-3.266 1.828h0.031v-1.578h-3.609s0.047 1.016 0 10.844v0h3.609v-6.062c0-0.313 0.016-0.641 0.109-0.875 0.266-0.641 0.859-1.313 1.859-1.313 1.297 0 1.813 0.984 1.813 2.453v5.797zM24 6.5v15c0 2.484-2.016 4.5-4.5 4.5h-15c-2.484 0-4.5-2.016-4.5-4.5v-15c0-2.484 2.016-4.5 4.5-4.5h15c2.484 0 4.5 2.016 4.5 4.5z"/></svg>
      </a>
      <a href="https://bsky.app/profile/utcompiegne.bsky.social" target="_blank" rel="noopener" aria-label="Bluesky">
        <img src={img('bluesky-logo.png')} alt="Bluesky" />
      </a>
    </div>
    <div class="utc-footer__legal">
      <a href="https://www.utc.fr/credits/">Crédits</a>
      <a href="https://www.utc.fr/mentions-legales/">Mentions légales</a>
      <a href="https://www.utc.fr/cookies/">Cookies</a>
      <a href="https://accessibilite.utc.fr/acc_declaration/wp-utc">Accessibilité - non-conforme</a>
    </div>
  </section>

  <section class="utc-footer__partners">
    <img src={img('logo-sorbonne-alliance-white.svg')} alt="Sorbonne université" />
    <a href="http://www.paris-sorbonne.fr/"><img src={img('02-sorbonne-logo-2.png')} alt="sorbonne" /></a>
    <a href="http://www.upmc.fr/fr/index.html"><img src={img('03-upmc-logo.png')} alt="UPMC" /></a>
    <a href="https://www.utc.fr/"><img src={img('logo-utc-footer-blanc.png')} alt="" /></a>
    <a href="http://www.insead.edu/home/"><img src={img('05-insead-logo.png')} alt="INSEAD" /></a>
    <a href="http://www.mnhn.fr/fr"><img src={img('06-museum-logo.png')} alt="Museum" /></a>
    <a href="http://www.pspbb.fr/fr/"><img src={img('07-partner-logo.png')} alt="" /></a>
    <a href="http://www.cnrs.fr/"><img src={img('logo-cnrs-2019-blanc.gif')} alt="" /></a>
    <a href="http://www.inserm.fr/"><img src={img('09-inserm-logo.png')} alt="INSERM" /></a>
    <a href="https://www.ird.fr/"><img src={img('10-ird-logo.png')} alt="IRD" /></a>
    <a href="http://www.inria.fr/"><img src={img('11-inria-logo.png')} alt="" /></a>
    <a href="http://www.ciep.fr/"><img src={img('12-partner-2.png')} alt="" /></a>
  </section>

  <section class="utc-footer__partners utc-footer__partners--mobile">
    <img src={img('logo-sorbonne-alliance-white.svg')} alt="Sorbonne université" />
    <a href="https://www.utc.fr/"><img src={img('logo-utc-footer-blanc.png')} alt="" /></a>
  </section>
</footer>

<style>
  .utc-footer {
    background: #1c2d5b;
    color: #ffffff;
    padding: 3rem 1.5rem 1.5rem;
    font-family: Inter, system-ui, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.6;
  }
  .utc-footer a { color: #ffffff; text-decoration: none; }
  .utc-footer a:hover { text-decoration: underline; }

  .utc-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.18);
  }
  .utc-footer__title {
    color: #f5bd21;
    font-size: 2rem;
    font-weight: 800;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  .utc-footer__title2 {
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .utc-footer__addr { margin-bottom: 1.25rem; }
  .utc-footer__logos {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .utc-footer__logos img { max-height: 48px; width: auto; }

  .utc-footer__col--nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .utc-footer__mid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.18);
  }
  .utc-footer__social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .utc-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .utc-footer__social svg {
    width: 28px;
    height: 28px;
    fill: #ffffff;
  }
  .utc-footer__social img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .utc-footer__legal {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 13px;
  }

  .utc-footer__partners {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
  }
  .utc-footer__partners img {
    max-height: 40px;
    width: auto;
  }
  .utc-footer__partners--mobile { display: none; }

  @media (max-width: 768px) {
    .utc-footer__top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .utc-footer__mid {
      flex-direction: column;
      align-items: flex-start;
    }
    .utc-footer__partners { display: none; }
    .utc-footer__partners--mobile { display: flex; }
  }
</style>
