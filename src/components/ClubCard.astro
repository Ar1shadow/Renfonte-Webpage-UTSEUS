---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface ClubData {
  slug: string;
  name: { en: string; fr: string; zh: string };
  description: { en: string; fr: string; zh: string };
  image: string;
  foundedYear: number;
}
interface Props { club: ClubData; lang: Lang; }
const { club, lang } = Astro.props;
const t = useTranslations(lang);
---
<article class="club-card">
  <figure class="club-card__figure">
    <img src={club.image} alt={club.name[lang]} loading="lazy" width="640" height="480" />
  </figure>
  <div class="club-card__body">
    <header class="club-card__head">
      <h4 class="club-card__name">{club.name[lang]}</h4>
      <span class="club-card__year">{t('campuslife.club.founded')} {club.foundedYear}</span>
    </header>
    <p class="club-card__desc">{club.description[lang]}</p>
  </div>
</article>

<style>
  .club-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem;
    align-items: stretch;
    padding: 1.25rem;
    border: 2px solid var(--color-fg);
    background: var(--color-bg);
  }
  .club-card__figure {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-fg);
  }
  .club-card__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .club-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .club-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }
  .club-card__name {
    margin: 0;
    font-family: var(--font-display, inherit);
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--color-fg);
  }
  .club-card__year {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-fg);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg);
    background: transparent;
  }
  .club-card__desc {
    margin: 0;
    color: var(--color-fg);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  @media (max-width: 720px) {
    .club-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
