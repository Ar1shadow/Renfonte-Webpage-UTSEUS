---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface ClubData {
  slug: string;
  name: { en: string; fr: string; zh: string };
  description: { en: string; fr: string; zh: string };
  image: string;
  foundedYear: number;
}
interface Props { club: ClubData; lang: Lang; }
const { club, lang } = Astro.props;
const t = useTranslations(lang);
---
<article class="club-card">
  <figure class="club-card__figure">
    <img src={club.image} alt={club.name[lang]} loading="lazy" width="640" height="480" />
  </figure>
  <div class="club-card__body">
    <header class="club-card__head">
      <h4 class="club-card__name">{club.name[lang]}</h4>
      <span class="club-card__year">{t('campuslife.club.founded')} {club.foundedYear}</span>
    </header>
    <p class="club-card__desc">{club.description[lang]}</p>
  </div>
</article>

<style>
  .club-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: 18rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-heading) 16%, transparent);
    border-radius: var(--radius-md);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(234, 240, 248, 0.66)),
      var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  .club-card:hover,
  .club-card:focus-within {
    border-color: color-mix(in srgb, var(--color-accent) 34%, transparent);
    box-shadow: 0 18px 38px rgba(23, 54, 93, 0.16);
    transform: translateY(-2px);
  }
  .club-card__figure {
    position: absolute;
    inset: 0 auto 0 0;
    width: 56%;
    margin: 0;
    overflow: hidden;
    background: var(--color-institutional-soft);
    -webkit-mask-image: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, 0.86) 58%, rgba(0, 0, 0, 0.22) 82%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0%, rgba(0, 0, 0, 0.86) 58%, rgba(0, 0, 0, 0.22) 82%, transparent 100%);
  }
  .club-card__figure::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(23, 54, 93, 0.9), rgba(23, 54, 93, 0.66)),
      var(--color-heading);
    mix-blend-mode: color;
    opacity: 0.96;
    pointer-events: none;
    transition: opacity 260ms ease;
  }
  .club-card__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(1) contrast(1.12) brightness(0.86);
    transition: filter 260ms ease, transform 260ms ease;
  }
  .club-card:hover .club-card__figure::after,
  .club-card:focus-within .club-card__figure::after {
    opacity: 0;
  }
  .club-card:hover .club-card__figure img,
  .club-card:focus-within .club-card__figure img {
    filter: grayscale(0) contrast(1) brightness(1);
    transform: scale(1.025);
  }
  .club-card__body {
    position: relative;
    z-index: 1;
    grid-column: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.95rem;
    min-width: 0;
    padding: 1.65rem 1.65rem 1.65rem 0.5rem;
  }
  .club-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .club-card__name {
    position: relative;
    margin: 0;
    font-family: var(--font-display, inherit);
    font-size: clamp(1.45rem, 1vw + 1.1rem, 2rem);
    font-weight: 850;
    line-height: 1.12;
    color: var(--color-heading);
  }
  .club-card__name::after {
    content: "";
    display: block;
    width: 3.6rem;
    height: 3px;
    margin-top: 0.55rem;
    border-radius: 999px;
    background: var(--gradient-sino-french);
  }
  .club-card__year {
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
    border-radius: var(--radius-sm);
    background: rgba(210, 31, 70, 0.06);
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .club-card__desc {
    margin: 0;
    color: var(--color-fg);
    font-size: 0.98rem;
    line-height: 1.68;
  }
  @media (max-width: 720px) {
    .club-card {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
    }
    .club-card__figure {
      position: relative;
      width: 100%;
      height: 13rem;
      -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.84) 68%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.84) 68%, transparent 100%);
    }
    .club-card__body {
      grid-column: 1;
      padding: 1.25rem;
    }
  }
</style>
