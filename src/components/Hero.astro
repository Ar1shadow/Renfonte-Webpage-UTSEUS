---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; title: string; tagline: string; }
const { lang, title, tagline } = Astro.props;
const t = useTranslations(lang);
---
<section id="hero" class="relative isolate overflow-hidden bg-bg">
  <div class="absolute inset-0 -z-10">
    <img src="/images/generated/hero-shanghai-campus.png" alt="" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/72 via-black/38 to-black/10"></div>
    <div class="absolute inset-0 mix-blend-multiply" style="background: var(--color-heading); opacity: 0.35;"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-bg to-transparent"></div>
  </div>
  <div class="mx-auto max-w-6xl px-4 min-h-[620px] flex flex-col justify-center py-24 md:py-32 text-white">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-white/80 reveal reveal--d1">UTC × SHU</p>
    <h1 class="hero-wordmark mt-4 reveal reveal--d2" aria-label={title}>
      <span aria-hidden="true">U</span><span aria-hidden="true" class="hero-wordmark__accent">T</span><span aria-hidden="true">SEUS</span>
    </h1>
    <p class="mt-5 text-xl md:text-2xl max-w-3xl text-white/90 reveal reveal--d3">{tagline}</p>
    <div class="hero-button-lab mt-8 reveal reveal--d3">
      <div class="hero-button-lab__options">
        <a href="#about" class="hero-cta hero-cta--arrow hero-cta--arrow-gradient">
          <span>A</span>
          <strong>{t('cta.discover')}</strong>
          <i aria-hidden="true">→</i>
        </a>
      </div>
    </div>
  </div>
</section>
